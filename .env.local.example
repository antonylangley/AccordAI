OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4.1-mini

# Public Supabase Auth client settings. These are safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase server-side persistence. Keep the service role key out of browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
